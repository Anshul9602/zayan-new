{{ header }}

<!-- Page Title -->
<section class="s-page-title" style="padding-top:100px;">
    <div class="container">
        <div class="content" style="padding-bottom: 19px;">
            <ul class="breadcrumbs-page">
                {% for breadcrumb in breadcrumbs %}
                    <li class="breadcrumb-item" style="display:flex;">
                        <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
                    </li>
                {% endfor %}
            </ul>
            <h1 class="title-page">Return Details</h1>
        </div>
    </div>
</section>
<!-- /Page Title -->

<!-- Return Details -->
<section class="flat-spacing-3">
    <div class="container">
        <div class="row">
            {{ column_left }}
            <div id="content" class="col">
                {{ content_top }}
                
                <!-- Return Header Info -->
                <div class="return-header mb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="info-card">
                                <div class="info-header">
                                    <i class="icon icon-refresh-cw"></i>
                                    <h4>{{ text_return_id }}</h4>
                                </div>
                                <div class="info-value">
                                    #{{ return_id }}
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <div class="info-header">
                                    <i class="icon icon-calendar"></i>
                                    <h4>{{ text_date_added }}</h4>
                                </div>
                                <div class="info-value">
                                    {{ date_added }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Information -->
                <div class="order-info mb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="info-card">
                                <div class="info-header">
                                    <i class="icon icon-package"></i>
                                    <h4>{{ text_order_id }}</h4>
                                </div>
                                <div class="info-value">
                                    #{{ order_id }}
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-card">
                                <div class="info-header">
                                    <i class="icon icon-calendar"></i>
                                    <h4>{{ text_date_ordered }}</h4>
                                </div>
                                <div class="info-value">
                                    {{ date_ordered }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Information -->
                <div class="product-section mb-4">
                    <div class="section-header">
                        <h3>Returned Product</h3>
                    </div>
                    <div class="product-card">
                        <div class="product-info">
                            <div class="product-details">
                                <h5 class="product-name">{{ product }}</h5>
                                <div class="product-meta">
                                    <span class="meta-item">
                                        <strong>Model:</strong> {{ model }}
                                    </span>
                                    <span class="meta-item">
                                        <strong>Quantity:</strong> {{ quantity }}
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Return Details -->
                <div class="return-details mb-4">
                    <div class="row g-3">
                        <div class="col-lg-4">
                            <div class="detail-card">
                                <div class="detail-header">
                                    <i class="icon icon-help-circle"></i>
                                    <h4>{{ text_reason }}</h4>
                                </div>
                                <div class="detail-content">
                                    {{ reason }}
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="detail-card">
                                <div class="detail-header">
                                    <i class="icon icon-box"></i>
                                    <h4>{{ text_opened }}</h4>
                                </div>
                                <div class="detail-content">
                                    {{ opened }}
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="detail-card">
                                <div class="detail-header">
                                    <i class="icon icon-settings"></i>
                                    <h4>{{ text_action }}</h4>
                                </div>
                                <div class="detail-content">
                                    {% if action %}{{ action }}{% else %}{{ text_tbc }}{% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Return Comment -->
                {% if comment %}
                    <div class="comment-section mb-4">
                        <div class="comment-card">
                            <div class="comment-header">
                                <i class="icon icon-message"></i>
                                <h4>{{ text_comment }}</h4>
                            </div>
                            <div class="comment-content">
                                {{ comment }}
                            </div>
                        </div>
                    </div>
                {% endif %}
                
                <!-- Return History -->
                <div class="history-section mb-4">
                    <div class="section-header">
                        <h3>{{ text_history }}</h3>
                    </div>
                    <div class="history-content">
                        <div id="history">{{ history }}</div>
                    </div>
                </div>
                
                <!-- Action Buttons -->
                <div class="return-actions text-center">
                    <a href="{{ continue }}" class="tf-btn btn-fill animate-btn">
                        <i class="icon icon-arrow-left"></i>
                        {{ button_continue }}
                    </a>
                </div>
                
                {{ content_bottom }}
            </div>
            {{ column_right }}
        </div>
    </div>
</section>
<!-- /Return Details -->
<script type="text/javascript"><!--
$('#history').on('click', '.pagination a', function(e) {
    e.preventDefault();

    $('#history').load(this.href);
});
//--></script>

<style>
/* Return Info Page Styling */
.return-header {
    margin-bottom: 30px;
}

.info-card, .detail-card, .comment-card {
    background: #fff;
    border: 1px solid #e9ecef;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    height: 100%;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.info-card:hover, .detail-card:hover, .comment-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    border-color: #241B68;
}

.info-header, .detail-header, .comment-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 1px solid #f1f1f1;
}

.info-header i, .detail-header i, .comment-header i {
    font-size: 20px;
    color: #241B68;
}

.info-header h4, .detail-header h4, .comment-header h4 {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: #333;
}

.info-value {
    font-size: 24px;
    font-weight: 700;
    color: #000;
}

.detail-content, .comment-content {
    color: #666;
    line-height: 1.6;
}

/* Product Section */
.product-section {
    background: #fff;
    border-radius: 12px;
    padding: 25px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.section-header {
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 2px solid #f1f1f1;
}

.section-header h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    color: #333;
}

.product-card {
    border: 1px solid #f1f1f1;
    border-radius: 8px;
    padding: 20px;
    background: #fafafa;
    transition: background-color 0.2s ease;
}

.product-card:hover {
    background: #f5f5f5;
    border-color: #241B68;
}

.product-name {
    margin: 0 0 10px 0;
    font-size: 18px;
    font-weight: 600;
    color: #000;
}

.product-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.meta-item {
    font-size: 14px;
    color: #666;
}

/* History Section */
.history-section {
    background: #fff;
    border-radius: 12px;
    padding: 25px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.history-content {
    max-height: 300px;
    overflow-y: auto;
}

/* Return Actions */
.return-actions {
    margin: 30px 0;
}

.return-actions .tf-btn {
    padding: 12px 30px;
    font-size: 16px;
    min-width: 200px;
}

/* Responsive Design */
@media (max-width: 768px) {
    .product-meta {
        justify-content: center;
    }
    
    .info-value {
        font-size: 20px;
    }
}

@media (max-width: 576px) {
    .info-card, .detail-card, .comment-card {
        margin-bottom: 15px;
    }
    
    .product-section, .history-section {
        padding: 15px;
    }
    
    .product-card {
        padding: 15px;
    }
}
</style>

{{ footer }}
