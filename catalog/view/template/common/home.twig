	<!-- New -->
	<div class=" flat-animate-tab pt-5 pb-5">
		<div class="container">
			<div class="sect-title wow fadeInUp">
				<div class="h1 title text-center mb-24">Featured Products</div>
				<ul class="tab-product_list" role="tablist">
					{% for tab in featured_tabs %}
						<li class="nav-tab-item" role="presentation">
							<a href="#tab-{{ tab.path_id }}" data-bs-toggle="tab" class="tf-btn-line tf-btn-tab {% if loop.index == 1 %}active{% endif %}">
								{{ tab.name }}
							</a>
						</li>
					{% endfor %}
				</ul>
			</div>
			<div class="tab-content">
				{% for tab in featured_tabs %}
					<div class="tab-pane {% if loop.index == 1 %}active show{% endif %}" id="tab-{{ tab.path_id }}" role="tabpanel">

						<div dir="ltr" class="swiper tf-swiper wrap-sw-over wow fadeInUp" data-preview="4" data-tablet="3" data-mobile-sm="2" data-mobile="2" data-space-lg="48" data-space-md="30" data-space="12" data-pagination="2" data-pagination-sm="2" data-pagination-md="3" data-pagination-lg="4" data-grid="2">
							<div class="swiper-wrapper">
								{% for product in tab.products %}
									<div class="swiper-slide">
										<div class="card-product grid" data-availability="In stock" data-brand="automet" data-product-id="{{ product.product_id }}">
											<div class="card-product_wrapper">
												<a
													href="{{ product.href }}" class="product-img">
													<img class="lazyload img-product" src="{{  product.thumb }}" data-src="{{ product.thumb }}" alt="{{ name }}">
																												<img class="lazyload img-hover" src="{{  product.thumb }}" data-src="{{ product.thumb }}" alt="{{ name }}">
													{# <img class="lazyload img-product" src="assets/RG.JPG" data-src="assets/RG.JPG" alt="{{ product.name }}">
													<img class="lazyload img-hover" src="assets/RG.JPG" data-src="assets/RG.JPG" alt="{{ product.name }}"> #}
												</a>
												<ul class="product-action_list">
													<li>
														<a href="#shoppingCart" data-bs-toggle="offcanvas" class="hover-tooltip tooltip-left box-icon btn-add-to-cart" data-url="{{ cart_add }}" data-product-id="{{ product.product_id }}" data-quantity="1">
															<span class="icon icon-shopping-cart-simple"></span>
															<span class="tooltip">Add to cart</span>
														</a>
													</li>
													<li class="wishlist">
														<a href="javascript:void(0);" class="hover-tooltip tooltip-left box-icon btn-add-wishlist" data-url="{{ wishlist_add }}" data-product-id="{{ product.product_id }}">
															<span class="icon icon-heart"></span>
															<span class="tooltip">Add to Wishlist</span>
														</a>
													</li>
													<li>
														<a href="#quickView" data-bs-toggle="modal" class="hover-tooltip tooltip-left box-icon btn-quick-view" data-product-id="{{ product.product_id }}">
															<span class="icon icon-view"></span>
															<span class="tooltip">Quick view</span>
														</a>
													</li>
												</ul>
											</div>
											<div class="card-product_info">
												<a href="{{ product.href }}" class="name-product h4 link">{{ product.name }}</a>
												<div class="price-wrap">
													{% if product.special %}
														<span class="price-old h6 fw-normal">{{ product.price }}</span>
														<span class="price-new h6">{{ product.special }}</span>
													{% else %}
														<span class="price-new h6">{{ product.price }}</span>
													{% endif %}
												</div>
												
											</div>
										</div>
									</div>
								{% endfor %}
							</div>
							<div class="sw-dot-default tf-sw-pagination"></div>
						</div>
					</div>


				{% endfor %}
			</div>

		</div>
	</div>
	<!-- /New -->

